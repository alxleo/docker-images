{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "prHourlyLimit": 8,
  "prConcurrentLimit": 20,
  "constraints": {
    "mise": "v2026.11.0"
  },
  "packageRules": [
    {
      "description": "FinRobot provider SDKs and the MCP facade share Pydantic AI constraints and must resolve as one runtime cohort.",
      "matchManagers": [
        "pep621"
      ],
      "matchFileNames": [
        "finrobot-mcp/pyproject.toml"
      ],
      "matchPackageNames": [
        "fastmcp",
        "pydantic-ai",
        "openai",
        "anthropic",
        "google-genai"
      ],
      "groupName": "FinRobot runtime"
    },
    {
      "description": "The shared image tool baseline updates with native mise lock hashes.",
      "matchManagers": [
        "mise"
      ],
      "groupName": "prepared CI toolchain",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "OpenTofu and conftest stay with the separately reviewed Atlantis executor pair.",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "opentofu",
        "conftest"
      ],
      "enabled": false
    },
    {
      "description": "Bun is copied from the upstream image after mise installation; both version pins must move together.",
      "matchPackageNames": [
        "bun",
        "oven/bun",
        "oven-sh/bun"
      ],
      "groupName": "prepared CI Bun"
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "node"
      ],
      "matchCurrentValue": "/^24\\./",
      "allowedVersions": "/^24\\./"
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "node"
      ],
      "matchCurrentValue": "/^26\\./",
      "allowedVersions": "/^26\\./"
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "python"
      ],
      "matchCurrentValue": "/^3\\.13\\./",
      "allowedVersions": "/^3\\.13\\./"
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "python"
      ],
      "matchCurrentValue": "/^3\\.14\\./",
      "allowedVersions": "/^3\\.14\\./"
    },
    {
      "description": "Mise owns these generated npm and Python graphs; update tool pins in mise.toml and regenerate with native mise lock.",
      "matchManagers": [
        "npm",
        "pep621"
      ],
      "matchFileNames": [
        "gitea-ci-runner/.mise/locks/**"
      ],
      "enabled": false
    }
  ]
}
