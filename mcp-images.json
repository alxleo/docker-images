    "contract": "mcp-contracts/mcp-youtube.json",
    "test_commands": [
      "docker run --rm --entrypoint python3 \"$IMAGE_REF\" -c \"from importlib.metadata import version; assert version('mcp').startswith('2.'); from mcp.server.mcpserver import MCPServer\""
    ]
