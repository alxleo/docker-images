  {
    "name": "mcp-youtube",
    "dockerfile": "Dockerfile.python",
    "build_args": "MCP_PACKAGE=git+https://github.com/jkawamoto/mcp-youtube-transcript@v0.8.3\nMCP_ENTRYPOINT=mcp-youtube-transcript\nMCP_SDK_SPEC=mcp>=2,<3",
    "tag": "0.8.3",
    "description": "YouTube transcript and video metadata extraction",
    "contract": "mcp-contracts/mcp-youtube.json",
    "test_commands": [
      "docker run --rm --entrypoint python3 \"$IMAGE_REF\" -c \"from importlib.metadata import version; assert version('mcp').startswith('2.'); from mcp.server.mcpserver import MCPServer\""
    ]
  },
  {
    "name": "mcp-zen",
    "dockerfile": "Dockerfile.python",
    "build_args": "MCP_PACKAGE=git+https://github.com/BeehiveInnovations/zen-mcp-server.git@v9.8.2\nMCP_ENTRYPOINT=pal-mcp-server",
    "tag": "9.8.2",
    "description": "Multi-model AI orchestrator (Gemini, OpenAI)",
    "contract": "mcp-contracts/mcp-zen.json",
    "test_commands": [
      "docker run --rm --entrypoint python3 \"$IMAGE_REF\" -c \"from importlib.metadata import version; assert version('mcp').startswith('1.'); from mcp.server import Server; assert hasattr(Server, 'list_tools')\""
    ],
    "smoke_env": [
      "GOOGLE_API_KEY=test-not-a-real-key",
      "OPENAI_API_KEY=test-not-a-real-key"
    ],
    "secrets": [
      "GOOGLE_API_KEY",
      "OPENAI_API_KEY"
    ]
  },
  {
