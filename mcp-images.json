    "dockerfile": "Dockerfile.python",
    "build_args": "MCP_PACKAGE=git+https://github.com/jkawamoto/mcp-youtube-transcript@v0.8.3\nMCP_ENTRYPOINT=mcp-youtube-transcript\nMCP_SDK_SPEC=mcp>=2,<3",
