{
  "name": "docs-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "astro build",
    "check": "DOCS_HUB_CONFIG_ROOT=./test-config astro check && DOCS_HUB_CONFIG_ROOT=./test-config node scripts/verify-contract.mjs",
    "start": "node server/controller.mjs",
    "test": "DOCS_HUB_CONFIG_ROOT=./test-config node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@astrojs/starlight": "0.41.8",
    "@excalidraw/excalidraw": "0.18.1",
    "@google/model-viewer": "4.3.1",
    "@scalar/api-reference": "1.66.1",
    "astro": "7.2.6",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "mermaid": "11.17.1",
    "minimatch": "10.2.6",
    "pdfjs-dist": "6.2.108",
    "plotly.js-dist-min": "4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tar-stream": "3.2.0",
    "three": "0.185.1",
    "vega-embed": "7.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.16",
      "@excalidraw/mermaid-to-excalidraw": {
        "nanoid": "5.1.16"
      }
    },
    "lodash-es": "4.18.1"
  }
}
