{
  "name": "docs-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "astro build",
    "check": "DOCS_HUB_CONFIG_ROOT=./test-config astro check && DOCS_HUB_CONFIG_ROOT=./test-config node scripts/verify-contract.mjs",
    "start": "node server/controller.mjs",
    "test": "DOCS_HUB_CONFIG_ROOT=./test-config node --test --test-isolation=none tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.1",
    "@astrojs/starlight": "0.41.4",
    "@excalidraw/excalidraw": "0.18.1",
    "@google/model-viewer": "4.3.1",
    "@scalar/api-reference": "1.63.0",
    "astro": "7.1.3",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "mermaid": "11.16.0",
    "minimatch": "10.2.5",
    "pdfjs-dist": "6.1.200",
    "plotly.js-dist-min": "3.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tar-stream": "3.2.0",
    "three": "0.183.2",
    "vega-embed": "7.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@types/leaflet": "1.9.20",
    "@types/node": "24.3.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "5.9.2"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.16",
      "@excalidraw/mermaid-to-excalidraw": {
        "nanoid": "5.1.16"
      }
    },
    "lodash-es": "4.18.1"
  }
}
