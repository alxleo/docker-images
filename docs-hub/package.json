{
  "name": "docs-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "astro build",
    "check": "DOCS_HUB_CONFIG_ROOT=./test-config astro check && DOCS_HUB_CONFIG_ROOT=./test-config node scripts/verify-contract.mjs",
    "start": "node server/controller.mjs",
    "test": "DOCS_HUB_CONFIG_ROOT=./test-config node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.7",
    "@astrojs/starlight": "0.42.10",
    "@excalidraw/excalidraw": "0.18.1",
    "@google/model-viewer": "4.4.0",
    "@scalar/api-reference": "1.78.0",
    "astro": "7.4.10",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "mermaid": "12.3.0",
    "minimatch": "11.0.7",
    "pdfjs-dist": "6.5.438",
    "plotly.js-dist-min": "4.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tar-stream": "3.2.2",
    "three": "0.187.0",
    "vega-embed": "7.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "@types/three": "0.187.0"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "6.0.2",
      "@excalidraw/mermaid-to-excalidraw": {
        "nanoid": "6.0.2",
        "katex": "0.19.1"
      }
    },
    "lodash-es": "4.18.1"
  }
}
