{
	admin off
}

(mcp-routes) {
	handle_path /echo/* {
		reverse_proxy echo:8080
	}
}

:80 {
	handle /health {
		respond "OK\n" 200
	}
	import mcp-routes
	handle {
		redir https://localhost{uri} permanent
	}
}

:81 {
	route {
		sablier http://sablier:10000 {
			group test
			dynamic
		}
		respond "ready\n" 200
	}
}
