+def _access_group_info_for_deployments(
+    deployments: Sequence[Mapping[str, Any]],
+) -> dict[str, AccessGroupInfo]:
+    deployments_by_group: dict[str, dict[str, str]] = {}
+    for index, deployment in enumerate(deployments):
+        model_info = model_info_as_mapping(deployment.get("model_info")) or {}
+        model_id = str(model_info.get("id") or f"deployment-{index}")
+        for access_group in model_info.get("access_groups", []):
+            deployments_by_group.setdefault(access_group, {})[model_id] = deployment["model_name"]
+    return {
+        access_group: AccessGroupInfo(
+            access_group=access_group,
+            model_names=sorted(frozenset(deployments.values())),
+            deployment_count=len(deployments),
+        )
+        for access_group, deployments in deployments_by_group.items()
+    }
