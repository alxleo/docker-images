diff --git a/pkg/idp/redirect_policy.go b/pkg/idp/redirect_policy.go
new file mode 100644
index 0000000..0799064
--- /dev/null
+++ b/pkg/idp/redirect_policy.go
@@ -0,0 +1,27 @@
+package idp
+
+import (
+	"net/netip"
+	"net/url"
+	"strings"
+)
+
+// MCP callbacks use HTTPS, except for local native-client HTTP listeners.
+func validRedirectURI(raw string) bool {
+	uri, err := url.Parse(raw)
+	if err != nil || uri.Opaque != "" || uri.Hostname() == "" || uri.User != nil || strings.Contains(raw, "#") {
+		return false
+	}
+	switch strings.ToLower(uri.Scheme) {
+	case "https":
+		return true
+	case "http":
+		if strings.EqualFold(uri.Hostname(), "localhost") {
+			return true
+		}
+		address, err := netip.ParseAddr(uri.Hostname())
+		return err == nil && address.Zone() == "" && address.Unmap().IsLoopback()
+	default:
+		return false
+	}
+}
diff --git a/pkg/idp/redirect_policy_test.go b/pkg/idp/redirect_policy_test.go
