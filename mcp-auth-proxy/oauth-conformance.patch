@@ -0,0 +1,60 @@
+package proxy
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/golang-jwt/jwt/v5"
+	"github.com/stretchr/testify/require"
+)
+
+func TestMCPBearerChallenges(t *testing.T) {
+	key, public, err := generateRSAKeyPair()
+	require.NoError(t, err)
+	for _, external := range []string{"https://auth.example", "https://auth.example/"} {
+		backend := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusOK) })
+		proxy, err := NewProxyRouter(external, backend, public, http.Header{}, false, false, nil, "/userinfo")
+		require.NoError(t, err)
+		router := gin.New()
+		proxy.SetupRoutes(router)
+		for _, header := range []string{"", "Basic bad", "Bearer ", "Bearer invalid.jwt.token"} {
+			request := httptest.NewRequest(http.MethodPost, "/hackernews/mcp", nil)
+			request.Host = "attacker.example"
+			request.Header.Set("Authorization", header)
+			response := httptest.NewRecorder()
+			router.ServeHTTP(response, request)
+			require.Equal(t, http.StatusUnauthorized, response.Code)
+			require.Contains(t, response.Header().Get("WWW-Authenticate"), `Bearer resource_metadata="https://auth.example/.well-known/oauth-protected-resource"`)
+			if header == "Bearer " || header == "Bearer invalid.jwt.token" {
+				require.Contains(t, response.Header().Get("WWW-Authenticate"), `error="invalid_token"`)
+			}
+		}
+		for _, claims := range []jwt.MapClaims{
+			{"iss": external, "aud": external, "exp": time.Now().Add(-time.Hour).Unix()},
+			{"iss": "https://other.example", "aud": external, "exp": time.Now().Add(time.Hour).Unix()},
+			{"iss": external, "aud": "https://other.example", "exp": time.Now().Add(time.Hour).Unix()},
+			{"iss": external, "aud": external, "exp": time.Now().Add(time.Hour).Unix()},
+		} {
+			token, err := createJWT(key, claims)
+			require.NoError(t, err)
+			request := httptest.NewRequest(http.MethodPost, "/hackernews/mcp", nil)
+			request.Header.Set("Authorization", "Bearer "+token)
+			response := httptest.NewRecorder()
+			router.ServeHTTP(response, request)
+			if claims["iss"] == external && claims["aud"] == external && claims["exp"].(int64) > time.Now().Unix() {
+				require.Equal(t, http.StatusOK, response.Code)
+				require.Empty(t, response.Header().Get("WWW-Authenticate"))
+			} else {
+				require.Equal(t, http.StatusUnauthorized, response.Code)
+				require.Contains(t, response.Header().Get("WWW-Authenticate"), `error="invalid_token"`)
+			}
+		}
+		response := httptest.NewRecorder()
+		router.ServeHTTP(response, httptest.NewRequest(http.MethodGet, OauthProtectedResourceEndpoint, nil))
+		require.Equal(t, http.StatusOK, response.Code)
+		require.Empty(t, response.Header().Get("WWW-Authenticate"))
+	}
+}
