+
+func TestRecoveryWithZap_IgnoresAbortHandler(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	core, logs := observer.New(zap.ErrorLevel)
+	router := gin.New()
+	router.Use(recoveryWithZap(zap.New(core)))
+	router.GET("/mcp", func(c *gin.Context) {
+		panic(http.ErrAbortHandler)
+	})
+
+	w := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet, "/mcp", nil)
+	router.ServeHTTP(w, req)
+
+	require.Empty(t, logs.All(), "expected client abort must not be logged as a server error")
+}
+
+func TestRecoveryWithZap_LogsUnexpectedPanic(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	core, logs := observer.New(zap.ErrorLevel)
+	router := gin.New()
+	router.Use(recoveryWithZap(zap.New(core)))
+	router.GET("/mcp", func(c *gin.Context) {
+		panic("unexpected")
+	})
+
+	w := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet, "/mcp", nil)
+	router.ServeHTTP(w, req)
+
+	require.Equal(t, http.StatusInternalServerError, w.Code)
+	require.Len(t, logs.All(), 1)
+	require.Equal(t, "[Recovery from panic]", logs.All()[0].Message)
+	require.Equal(t, "unexpected", logs.All()[0].ContextMap()["error"])
+}
