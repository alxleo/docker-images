{
  "typeCheckingMode": "standard",
  "reportMissingImports": "warning",
  "reportMissingModuleSource": "none",
  "reportMissingTypeStubs": "none",
  "pythonVersion": "3.11",
  "exclude": [
    "**/node_modules",
    "**/.venv",
    "**/__pycache__",
    "examples/"
  ],
  "executionEnvironments": [
    {
      "root": "../mcp-search",
      "pythonVersion": "3.14",
      "extraPaths": [
        "../mcp-search/.venv/lib/python3.14/site-packages"
      ]
    }
  ]
}
